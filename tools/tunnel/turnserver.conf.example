# 独立 DSHX coturn；复制后替换地址和密钥，实际文件权限设为 root:turnserver 0640。
listening-port=3478
listening-ip=172.18.9.5
relay-ip=172.18.9.5
external-ip=47.119.120.17/172.18.9.5
min-port=49160
max-port=49259
realm=dshx-tunnel.filesharing.asia
server-name=dshx-tunnel.filesharing.asia
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
stale-nonce=600
user-quota=16
total-quota=200
max-bps=1048576
bps-capacity=20971520
relay-threads=2
no-tcp-relay
no-tls
no-dtls
no-cli
no-multicast-peers
# 禁止把中继用作服务器内网、回环或云元数据入口。
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=ff00::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
userdb=/var/lib/dshx-turn/turndb
pidfile=/run/dshx-turn/turnserver.pid
log-file=stdout
simple-log
